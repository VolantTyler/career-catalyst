# Cursor Cloud Agents API key (dashboard → Cloud Agents)
CURSOR_API_KEY=

# Default model id for local agents; validated against Cursor.models.list().
# Use "auto" only after confirming your account resolves it (SDK falls back to composer-2).
CURSOR_MODEL=composer-2

# local | cloud — cloud requires a GitHub repo URL and account linkage.
CAREER_CATALYST_RUNTIME=local

# Absolute or relative path used as local agent cwd (default: project root).
# CAREER_CATALYST_CWD=.

# SQLite database path is `${dataDir}/${name}` (see CAREER_CATALYST_DATA_DIR).
# CAREER_CATALYST_DB_NAME=catalyst-sdk.sqlite
CAREER_CATALYST_DATA_DIR=data

# Cloud runtime only
# CAREER_CATALYST_CLOUD_REPO_URL=https://github.com/org/repo
# CAREER_CATALYST_CLOUD_REF=main
# CAREER_CATALYST_CLOUD_AUTO_PR=false
# CAREER_CATALYST_CLOUD_SKIP_REVIEWER=true
# Omit model on cloud and use account default server-side:
# CAREER_CATALYST_CLOUD_ACCOUNT_DEFAULT_MODEL=false

# Resume an existing agent from SQLite session metadata (sdk:send)
# CAREER_CATALYST_RESUME_AGENT=
